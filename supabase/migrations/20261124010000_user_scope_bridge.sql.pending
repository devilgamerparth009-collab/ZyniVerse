-- PENDING — DO NOT APPLY YET.
--
-- Identity bridge + user-scoped RLS for direct reads of private rows.
--
-- Blockers (both must be resolved first):
--   1. Supabase project is paused (REST returns 402).
--   2. No SUPABASE_JWT_SECRET in the environment, so the server cannot mint a
--      Supabase JWT from the Auth.js session the APK currently uses. Until a
--      login exchange exists, auth.uid() is always null for app requests.
--
-- Design decision: keep a separate mapping table instead of adding a
-- supabaseAuthId column to `User`, so the Prisma schema does not change and the
-- website keeps working exactly as before. All writes/side effects stay on the
-- server. This file only unlocks SELECT of a user's own rows.

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'authenticated') THEN
    CREATE ROLE authenticated NOLOGIN NOINHERIT;
  END IF;
END
$$;

-- One row per app account. The server writes this mapping when it provisions or
-- refreshes a Supabase identity; anon/authenticated can never write it.
CREATE TABLE IF NOT EXISTS public_zv_auth_bridge (
  "userId"         text PRIMARY KEY,
  "supabaseAuthId" uuid NOT NULL UNIQUE,
  "linkedAt"       timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE public_zv_auth_bridge ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON TABLE public_zv_auth_bridge FROM anon, authenticated;

-- Helper: true when the caller's Supabase JWT maps to this app user id.
CREATE OR REPLACE FUNCTION public_zv_is_self(target_user_id text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT target_user_id IS NOT NULL
     AND EXISTS (
       SELECT 1 FROM public_zv_auth_bridge b
       WHERE b."userId" = target_user_id
         AND b."supabaseAuthId" = auth.uid()
     );
$$;

REVOKE ALL ON FUNCTION public_zv_is_self(text) FROM anon;
GRANT EXECUTE ON FUNCTION public_zv_is_self(text) TO authenticated;

-- User-scoped SELECT policies. No policies for anon: default deny.
DO $$
DECLARE
  t text;
  scoped text[] := ARRAY['ListEntry', 'Notification', 'Follow', 'FriendRequest',
                         'EpisodeProgress', 'SavedPost', 'UserSession'];
BEGIN
  FOREACH t IN ARRAY scoped LOOP
    IF to_regclass('public."' || t || '"') IS NOT NULL THEN
      EXECUTE format('DROP POLICY IF EXISTS "zv_own_read_%I" ON public."%I"', t, t);
      EXECUTE format(
        'CREATE POLICY "zv_own_read_%I" ON public."%I" FOR SELECT TO authenticated USING (public_zv_is_self("userId"))',
        t, t
      );
    END IF;
  END LOOP;
END
$$;

-- Follow / FriendRequest use followerId / senderId instead of userId.
ALTER TABLE "Follow" ENABLE ROW LEVEL SECURITY;
DROP POLICY IF EXISTS "zv_own_follow_read" ON "Follow";
CREATE POLICY "zv_own_follow_read" ON "Follow" FOR SELECT TO authenticated
USING (public_zv_is_self("followerId") OR public_zv_is_self("followingId"));

ALTER TABLE "FriendRequest" ENABLE ROW LEVEL SECURITY;
DROP POLICY IF EXISTS "zv_own_friend_read" ON "FriendRequest";
CREATE POLICY "zv_own_friend_read" ON "FriendRequest" FOR SELECT TO authenticated
USING (public_zv_is_self("senderId") OR public_zv_is_self("receiverId"));

-- Guest vote state must STAY server-side: it is keyed by device id, which a
-- Supabase JWT can never express. Deliberately no policy on vote tables.

-- Private views use security_invoker = true so RLS above is enforced.
CREATE OR REPLACE VIEW private_zv_list_entries WITH (security_invoker = true) AS
SELECT "id", "userId", "mediaId", "type", "status", "progress", "total", "score",
       "startedAt", "completedAt", "createdAt", "updatedAt"
FROM "ListEntry";

CREATE OR REPLACE VIEW private_zv_notifications WITH (security_invoker = true) AS
SELECT "id", "userId", "type", "title", "body", "read", "createdAt"
FROM "Notification";

GRANT SELECT ON TABLE private_zv_list_entries, private_zv_notifications TO authenticated;
REVOKE ALL ON TABLE private_zv_list_entries, private_zv_notifications FROM anon;

-- Verification once unblocked (as an authenticated Supabase user):
--   select count(*) from private_zv_list_entries;      -- only own rows
--   select * from public_zv_auth_bridge;               -- 0 rows (no policy)
--   select * from "User" limit 1;                      -- 0 rows / denied
